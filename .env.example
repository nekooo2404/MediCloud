# MediCloud Environment Configuration Example
# Sao chép thành .env và thay đổi toàn bộ giá trị placeholder trước khi deploy production.

# --- Chế độ môi trường ---
# Dùng 'development' để thử nghiệm nhanh hoặc 'production' khi có OIDC + bí mật thật.
MEDICLOUD_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=synthetic
POSTGRES_DB=medicloud
DATABASE_URL=postgresql://postgres:synthetic@localhost:5432/medicloud?schema=public

# --- Clinical API Backend ---
HOST=0.0.0.0
PORT=4000
# Danh sách origin frontend được phép CORS (phân tách bằng dấu phẩy khi deploy domain thật)
CORS_ALLOWED_ORIGINS=https://localhost:3000,https://localhost:3001

# Bắt buộc khi MEDICLOUD_ENV=production (>= 16 ký tự cho secret)
BFF_ACTOR_SIGNING_SECRET=synthetic-dev-actor-signing-secret-do-not-use-in-prod
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# --- Patient & Staff Portal Frontend / BFF ---
CLINICAL_API_BASE_URL=http://127.0.0.1:4000
CLINICAL_API_SERVICE_TOKEN=synthetic-bff-patient
PORTAL_SESSION_SECRET=synthetic-medicloud-p0-portal-session-secret-not-for-prod
PATIENT_PORT=3000
STAFF_PORT=3001
API_PORT=4000
