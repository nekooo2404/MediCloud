{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{"name": "next"}],
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./apps/patient-portal/*"]
    }
  },
  "include": ["tools/medicloud-agent-company/src/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "apps/patient-portal/**/*.ts", "apps/patient-portal/**/*.tsx", "apps/patient-portal/.next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
