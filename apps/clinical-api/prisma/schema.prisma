generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  PATIENT
  GUARDIAN
  RECEPTIONIST
  PHYSICIAN
  NURSE
  AUDITOR
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum CheckInStatus {
  NOT_CHECKED_IN
  CHECKED_IN
  VOIDED
}

enum QueueTicketStatus {
  CHECKED_IN
  WAITING
  CALLED
  IN_SERVICE
  DONE
  SKIPPED
}

enum EncounterStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  AMENDED
  CANCELLED
}

enum ObservationStatus {
  DRAFT
  PRELIMINARY
  FINAL
  AMENDED
}

enum OutboxStatus {
  PENDING
  CLAIMED
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum ProcessedEventStatus {
  PROCESSING
  PROCESSED
}

model Tenant {
  id            String            @id @default(uuid()) @db.Uuid
  code          String            @unique @db.VarChar(64)
  name          String            @db.VarChar(160)
  status        TenantStatus      @default(ACTIVE)
  organizations       Organization[]
  departments         Department[]
  memberships         Membership[]
  patients            Patient[]
  patientProfiles     PatientProfile[]
  guardianDelegations GuardianDelegation[]
  practitioners       Practitioner[]
  schedules           Schedule[]
  slots               AppointmentSlot[]
  appointments        Appointment[]
  queueTickets        QueueTicket[]
  encounters          Encounter[]
  observations        Observation[]
  outboxEvents        OutboxEvent[]
  auditEvents         AuditEvent[]

  @@map("tenants")
}

model Organization {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  code          String?        @db.VarChar(64)
  name          String         @db.VarChar(160)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departments   Department[]
  practitioners Practitioner[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("organizations")
}

model Department {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  organizationId String         @db.Uuid
  code           String         @db.VarChar(64)
  name           String         @db.VarChar(160)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization   Organization   @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)
  practitioners  Practitioner[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, organizationId])
  @@map("departments")
}

model User {
  id                         String               @id @default(uuid()) @db.Uuid
  subject                    String               @unique @db.VarChar(255)
  email                      String?              @unique @db.VarChar(255)
  passwordHash               String?              @db.VarChar(255)
  displayName                String?              @db.VarChar(160)
  emailVerifiedAt            DateTime?            @db.Timestamptz(3)
  emailVerificationTokenHash String?              @db.VarChar(128)
  passwordResetTokenHash     String?              @db.VarChar(128)
  passwordResetExpiresAt     DateTime?            @db.Timestamptz(3)
  status                     UserStatus           @default(ACTIVE)
  memberships                Membership[]
  sessions                   UserSession[]
  patients                   Patient[]            @relation("PatientUser")
  guardianDelegations   GuardianDelegation[] @relation("GuardianUser")
  practitioners         Practitioner[]
  auditEvents           AuditEvent[]
  checkedInAppointments Appointment[]        @relation("AppointmentCheckedInBy")
  cancelledAppointments Appointment[]        @relation("AppointmentCancelledBy")
  completedEncounters   Encounter[]          @relation("EncounterCompletedBy")
  authoredObservations  Observation[]        @relation("ObservationAuthor")

  @@map("users")
}

model Membership {
  id       String         @id @default(uuid()) @db.Uuid
  tenantId String         @db.Uuid
  userId   String         @db.Uuid
  role     MembershipRole
  revokedAt DateTime?
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, role])
  @@index([tenantId, userId])
  @@map("memberships")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tenantId  String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  role      String    @db.VarChar(32)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model Patient {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @db.Uuid
  userId              String?              @db.Uuid
  profileRef          String               @db.VarChar(128)
  status              PatientStatus        @default(ACTIVE)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                User?                @relation("PatientUser", fields: [userId], references: [id], onDelete: Restrict)
  profile             PatientProfile?
  guardianDelegations GuardianDelegation[]
  appointments        Appointment[]
  queueTickets        QueueTicket[]
  encounters          Encounter[]

  @@unique([tenantId, id])
  @@unique([tenantId, profileRef])
  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@map("patients")
}

model PatientProfile {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  patientId         String   @db.Uuid
  displayName       String   @db.VarChar(160)
  medicalRecordCode String   @db.VarChar(64)
  bloodType         String?  @db.VarChar(16)
  allergies         String[] @default([])
  careTeamNotes     String?  @db.VarChar(500)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient           Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, patientId])
  @@unique([tenantId, medicalRecordCode])
  @@map("patient_profiles")
}

model GuardianDelegation {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  guardianUserId String    @db.Uuid
  patientId      String    @db.Uuid
  scope          String    @default("FULL_PORTAL") @db.VarChar(64)
  expiresAt      DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  guardianUser   User      @relation("GuardianUser", fields: [guardianUserId], references: [id], onDelete: Restrict)
  patient        Patient   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, guardianUserId, patientId])
  @@index([tenantId, patientId])
  @@map("guardian_delegations")
}

model Practitioner {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  userId         String        @db.Uuid
  organizationId String?       @db.Uuid
  departmentId   String?       @db.Uuid
  specialty      String        @db.VarChar(120)
  displayName    String?       @db.VarChar(160)
  roomLabel      String?       @db.VarChar(64)
  degreeTitle    String?       @db.VarChar(120)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)
  department     Department?   @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  schedules      Schedule[]
  encounters     Encounter[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, specialty])
  @@index([tenantId, departmentId])
  @@map("practitioners")
}

model Schedule {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  practitionerId String            @db.Uuid
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  practitioner   Practitioner      @relation(fields: [tenantId, practitionerId], references: [tenantId, id], onDelete: Restrict)
  slots          AppointmentSlot[]

  @@unique([tenantId, id])
  @@index([tenantId, practitionerId, startsAt])
  @@map("schedules")
}

model AppointmentSlot {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  scheduleId   String        @db.Uuid
  startsAt     DateTime      @db.Timestamptz(3)
  endsAt       DateTime      @db.Timestamptz(3)
  capacity     Int
  bookedCount  Int           @default(0)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schedule     Schedule      @relation(fields: [tenantId, scheduleId], references: [tenantId, id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, scheduleId, startsAt])
  @@index([tenantId, startsAt])
  @@index([tenantId, scheduleId, startsAt])
  @@map("appointment_slots")
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  patientId         String            @db.Uuid
  slotId            String            @db.Uuid
  status            AppointmentStatus @default(PENDING)
  checkInStatus     CheckInStatus     @default(NOT_CHECKED_IN)
  checkedInAt       DateTime?         @db.Timestamptz(3)
  checkedInByUserId String?           @db.Uuid
  idempotencyKey    String            @db.VarChar(128)
  actorSubject      String?           @db.VarChar(255)
  requestHash       String?           @db.VarChar(128)
  visitType         String?           @db.VarChar(40)
  visitReason       String?           @db.VarChar(120)
  intakeNote        String?           @db.VarChar(600)
  cancelReason      String?           @db.VarChar(300)
  cancelledAt       DateTime?         @db.Timestamptz(3)
  cancelledByUserId String?           @db.Uuid
  rescheduledFromId String?           @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient           Patient           @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  slot              AppointmentSlot   @relation(fields: [tenantId, slotId], references: [tenantId, id], onDelete: Restrict)
  encounters        Encounter[]
  queueTicket       QueueTicket?
  checkedInBy       User?             @relation("AppointmentCheckedInBy", fields: [checkedInByUserId], references: [id], onDelete: Restrict)
  cancelledBy       User?             @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  rescheduledFrom   Appointment?      @relation("AppointmentReschedule", fields: [tenantId, rescheduledFromId], references: [tenantId, id], onDelete: Restrict)
  rescheduledTo     Appointment[]     @relation("AppointmentReschedule")

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, patientId])
  @@index([tenantId, slotId, status])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, patientId, createdAt])
  @@map("appointments")
}

model QueueTicket {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  appointmentId String            @db.Uuid
  patientId     String            @db.Uuid
  ticketNumber  String            @db.VarChar(32)
  status        QueueTicketStatus @default(CHECKED_IN)
  calledAt      DateTime?         @db.Timestamptz(3)
  startedAt     DateTime?         @db.Timestamptz(3)
  completedAt   DateTime?         @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointment   Appointment       @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  patient       Patient           @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId])
  @@index([tenantId, status, createdAt])
  @@map("queue_tickets")
}

model Encounter {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  appointmentId     String          @db.Uuid
  patientId         String          @db.Uuid
  practitionerId    String          @db.Uuid
  status            EncounterStatus @default(OPEN)
  version           Int             @default(1)
  startedAt         DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?       @db.Timestamptz(3)
  cancelledAt       DateTime?       @db.Timestamptz(3)
  cancelReason      String?         @db.VarChar(300)
  completedByUserId String?         @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointment       Appointment     @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  patient           Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  practitioner      Practitioner    @relation(fields: [tenantId, practitionerId], references: [tenantId, id], onDelete: Restrict)
  completedBy       User?           @relation("EncounterCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  observations      Observation[]

  @@unique([tenantId, id])
  @@index([tenantId, practitionerId])
  @@index([tenantId, patientId])
  @@index([tenantId, status, createdAt])
  @@map("encounters")
}

model Observation {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  encounterId  String            @db.Uuid
  code         String            @db.VarChar(64)
  value        Decimal           @db.Decimal(12, 4)
  unit         String            @db.VarChar(32)
  status       ObservationStatus @default(PRELIMINARY)
  version      Int               @default(1)
  isLatest     Boolean           @default(true)
  authorUserId String?           @db.Uuid
  supersedesId String?           @db.Uuid
  amendReason  String?           @db.VarChar(300)
  measuredAt   DateTime          @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  encounter    Encounter         @relation(fields: [tenantId, encounterId], references: [tenantId, id], onDelete: Restrict)
  author       User?             @relation("ObservationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  supersedes   Observation?      @relation("ObservationAmendment", fields: [tenantId, supersedesId], references: [tenantId, id], onDelete: Restrict)
  amendedBy    Observation[]     @relation("ObservationAmendment")

  @@unique([tenantId, id])
  @@index([tenantId, encounterId, measuredAt])
  @@index([tenantId, encounterId, isLatest, measuredAt])
  @@map("observations")
}

model OutboxEvent {
  eventId       String       @id @db.Uuid
  tenantId      String       @db.Uuid
  eventType     String       @db.VarChar(80)
  schemaVersion Int          @default(1)
  correlationId String       @db.VarChar(128)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)
  claimedAt     DateTime?
  claimToken    String?      @db.Uuid
  deliveredAt   DateTime?    @db.Timestamptz(3)
  lastError     String?      @db.VarChar(500)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, nextAttemptAt])
  @@unique([eventId, claimToken])
  @@map("outbox_events")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  actorId       String?  @db.Uuid
  action        String   @db.VarChar(80)
  resourceRef   String   @db.VarChar(160)
  purpose       String   @db.VarChar(120)
  correlationId String   @db.VarChar(128)
  metadata      Json?
  occurredAt    DateTime @default(now()) @db.Timestamptz(3)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@index([tenantId, resourceRef])
  @@map("audit_events")
}

model ProcessedEvent {
  eventId     String              @db.Uuid
  handler     String              @db.VarChar(120)
  status      ProcessedEventStatus @default(PROCESSING)
  duplicateCount Int               @default(0)
  claimToken     String?            @db.Uuid
  processedAt DateTime            @default(now()) @db.Timestamptz(3)

  @@id([eventId, handler])
  @@map("processed_events")
}
